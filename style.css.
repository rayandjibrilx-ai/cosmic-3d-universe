
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  overflow: hidden;
  background: #02030b;
  color: white;
  font-family: Arial, sans-serif;
}

canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 0;
}

header {
  position: fixed;
  top: 28px;
  left: 35px;
  z-index: 2;
  pointer-events: none;
}

header h1 {
  font-size: 28px;
  letter-spacing: 5px;
  text-shadow: 0 0 18px #00cfff;
}

header h1 span {
  color: #00d9ff;
}

header p {
  margin-top: 10px;
  color: #a5b8d9;
  font-size: 10px;
  letter-spacing: 3px;
}

#info {
  position: fixed;
  right: 30px;
  top: 50%;
  transform: translateY(-50%);
  width: 280px;
  padding: 24px;
  border: 1px solid #245d8b;
  border-radius: 16px;
  background: rgba(4, 12, 32, 0.82);
  box-shadow: 0 0 30px rgba(0, 160, 255, 0.12);
  z-index: 2;
  pointer-events: none;
}

#planet-name {
  color: #43dcff;
  font-size: 21px;
  letter-spacing: 2px;
  margin-bottom: 14px;
}

#planet-description {
  color: #c0cde1;
  font-size: 14px;
  line-height: 1.8;
}

#controls {
  position: fixed;
  bottom: 25px;
  left: 50%;
  transform: translateX(-50%);
  width: max-content;
  max-width: 92%;
  padding: 13px 20px;
  border: 1px solid #21466c;
  border-radius: 30px;
  background: rgba(3, 9, 25, 0.85);
  color: #a7dfff;
  font-size: 11px;
  letter-spacing: 1.5px;
  text-align: center;
  z-index: 2;
}

#loading {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  background: #02030b;
  color: #42dfff;
  font-size: 15px;
  letter-spacing: 5px;
  z-index: 10;
}

@media (max-width: 600px) {
  header {
    top: 18px;
    left: 18px;
  }

  header h1 {
    font-size: 20px;
  }

  #info {
    top: auto;
    bottom: 80px;
    right: 12px;
    width: 210px;
    padding: 14px;
    transform: none;
  }

  #planet-name {
    font-size: 16px;
  }

  #controls {
    font-size: 9px;
    bottom: 15px;
  }
}
